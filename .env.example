# This is a template for the `.env` file that is used as part of local development.
# You can copy this file, rename it to `.env` and fill in the missing values,
# then delete this header.
###############################################################################

# This file should contain all the secrets required by *development* (local) application.
# This file is ignored by git by default to avoid accidentally exposing secrets in your repository.

SECRET_KEY="django-insecure-tqSH9gWpm3BO3HE8FBZMBbvW4pzcZVi1KFmzi1hk"
# host should be "127.0.0.1" for native development or "db" for docker-based development
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/project"
# host should be "127.0.0.1" for native development or "redis" for docker-based development
REDIS_URL="redis://127.0.0.1:6379"

# Sites (project/settings.py SITES). Domains default to directory.localhost and productivity.localhost.
# The four domain and sender keys are required in production.
# DIRECTORY_DOMAIN="directory.example.com"
# PRODUCTIVITY_DOMAIN="productivity.example.com"
# DIRECTORY_FROM_EMAIL="hello@directory.example.com"
# PRODUCTIVITY_FROM_EMAIL="hello@productivity.example.com"
DIRECTORY_GOOGLE_ANALYTICS_ID=""
PRODUCTIVITY_GOOGLE_ANALYTICS_ID=""

# Stripe (apps.billing, dj-stripe). Test mode unless STRIPE_LIVE_MODE=True; production requires STRIPE_LIVE_MODE
# and the secret key of that mode. Forward test webhooks locally with the Stripe CLI logged in:
#   uv run manage.py stripe_listen --host productivity.localhost --port $DJANGO_PORT
STRIPE_LIVE_MODE=False
STRIPE_TEST_SECRET_KEY=""
STRIPE_TEST_PUBLIC_KEY=""
# STRIPE_LIVE_SECRET_KEY=""
# STRIPE_LIVE_PUBLIC_KEY=""
# Each site's Customer Portal configuration, printed by `uv run manage.py create_portal_configurations`.
# Empty uses Stripe's default portal, which may offer every site's plans; production requires both.
DIRECTORY_STRIPE_PORTAL_CONFIGURATION=""
PRODUCTIVITY_STRIPE_PORTAL_CONFIGURATION=""

# Development server ports
DJANGO_PORT=8000
DJANGO_VITE_PORT=5173

# Docker service ports
POSTGRES_PORT=5432
REDIS_PORT=6379

# turnstile setup - add your keys here to enable turnstile
TURNSTILE_KEY=""
TURNSTILE_SECRET=""

# Site URL and email addresses. Unset, settings.py falls back to localhost placeholders
# (production settings require ADMINS). ADMINS is a comma-separated list.
# PROJECT_URL (scheme://host[:port], no trailing slash) only names the first Site row, created on the first
# migrate. No site uses that row: the sites and their domains come from SITES (see above) and sync_sites.
# PROJECT_URL="http://localhost:8000"
# CONTACT_EMAIL="hello@example.com"
# ADMINS="admin@example.com,ops@example.com"
# DEFAULT_FROM_EMAIL="hello@example.com"
# SERVER_EMAIL="noreply@example.com"

# Production keys, read by project/settings_production.py (DJANGO_SETTINGS_MODULE=project.settings_production).
# SECRET_KEY, ADMINS, DEFAULT_FROM_EMAIL and SERVER_EMAIL (above) are required there; the web service also
# needs ALLOWED_HOSTS (comma-separated; Railway's health-check host and the service's railway.app domain are added).
# The AWS_* bucket keys are required too (.railway/railway.ts wires them from the Railway bucket).
# The rest are optional: unset, Sentry is off, sending email raises, and sign-up has no Turnstile captcha.
# ALLOWED_HOSTS="example.com,www.example.com"
# SECURE_HSTS_SECONDS=60
# SENTRY_DSN="https://key@o0.ingest.sentry.io/0"
# SENTRY_ENVIRONMENT="production"
# POSTMARK_SERVER_TOKEN="***"
# Railway storage bucket (private; file URLs are presigned).
# AWS_STORAGE_BUCKET_NAME="<bucket's BUCKET variable>"
# AWS_ACCESS_KEY_ID="***"
# AWS_SECRET_ACCESS_KEY="***"
# AWS_S3_ENDPOINT_URL="https://t3.storageapi.dev"
# AWS_S3_REGION_NAME="auto"

# You can uncomment these settings to use a different email backend in settings.py.
# Depending on your selected backend, you will probably need to add additional settings / environment variables

# EMAIL_BACKEND="anymail.backends.mailgun.EmailBackend"
# MAILGUN_API_KEY="key-***"
# MAILGUN_SENDER_DOMAIN="example.com"
